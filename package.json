{
  "name": "film-archive",
  "version": "1.0.0",
  "description": "ارشیو فیزیکی فیلم‌ها - وب اپ با React و Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "template": "node server/make-template.js",
    "deploy": "npm run build && npx wrangler deploy",
    "db:init": "npx wrangler d1 execute movies-archive --file=schema.sql",
    "gallery:build": "node scripts/build-gallery-media.mjs",
    "sphere:build": "node scripts/build-sphere-atlas.mjs"
  },
  "dependencies": {
    "@tweakpane/plugin-essentials": "^0.2.1",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "ogl": "^1.0.11",
    "tweakpane": "^4.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "dxt-js": "^0.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "vite": "^5.4.8",
    "vite-plugin-glsl": "^1.3.0"
  }
}
